{
  "id": "paseo-task-manager",
  "name": "任务看板中心",
  "description": "采集所选 Paseo 主机的会话，运行任务看板、摘要调度和 MCP 服务。",
  "requirements": {
    "paseo": ">=0.17.0"
  },
  "build": [
    [
      "npm",
      "ci",
      "--omit=dev",
      "--ignore-scripts",
      "--no-audit",
      "--no-fund"
    ],
    [
      "npm",
      "run",
      "build"
    ]
  ],
  "media": [
    "assets/history-import.png"
  ]
}
